# Copy to .env before running docker compose.
#
# JWT_SECRET has no default anywhere in the stack, and compose refuses to start
# without it. That is deliberate: a fallback signing key in a repository is a
# signing key anyone can read. Generate one, for example:
#
#   openssl rand -base64 48
#
JWT_SECRET=replace-me-with-at-least-32-random-characters

# Optional overrides.
DB_PASSWORD=loantracker
JWT_EXPIRY_MINUTES=120
CORS_ORIGINS=http://localhost:3000
SEED_DEMO_DATA=true
